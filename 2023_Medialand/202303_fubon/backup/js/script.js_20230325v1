        COM_ID: USER_DATA.ID,
        COM_IMG: USER_DATA.IMAGE,
        COM_NAM: USER_DATA.NAME
    };
    console.log(postData)

    $.ajax({
        type: 'POST',
        cache: 'false',
        url: API_DOMAIN + 'Signup',
        data: postData,
        dataType: "json",
        success: function(resp) {
            if (resp && resp.rs == API_RESPONSE.OK) {
                USER_DATA.API_TOKEN = resp.msg;
